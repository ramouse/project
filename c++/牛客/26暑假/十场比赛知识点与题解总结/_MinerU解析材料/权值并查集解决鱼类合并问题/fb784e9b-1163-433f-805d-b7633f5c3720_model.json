            ],
            "angle": 0,
            "content": "const int INF = 2e9;\n\nstruct DSU {\n    vector<int> parent;\n    vector<int> max_w;\n    vector<int> sz;\n    vector<int> val; // 记录每条鱼的初始大小 v\n\n    DSU(int n) {\n    parent.resize(n + 1);\n    max_w.assign(n + 1, -INF);\n    sz.assign(n + 1, 1);\n    val.resize(n + 1);\n    for (int i = 0; i <= n; i++) parent[i] = i;\n    }\n\n    int find(int i) {\n    if (parent[i] == i) return i;\n    int root = find(parent[i]);\n    max_w[i] = max(max_w[i], max_w(parent[i]]);\n    return parent[i] = root;\n    }\n\n    void merge(int u, int v_parent, int val_p) {\n    int root_u = find(u);\n    if (root_u != v_parent) {\n    max_w[root_u] = val_p - sz[root_u] + 1;\n    parent[root_u] = v_parent;\n    sz[v_parent] += sz[root_u];\n    }\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);"
        }
    ],
    [
        {
            "type": "code",
            "bbox": [
                0.075,
                0.095,
                0.69,
                0.921
            ],
            "angle": 0,
            "content": "int n, m, q;\nif (!(cin >> n >> m >> q)) return 0;\n\n// 用一个二维数组记录网格中每个位置对应的鱼的节点编号，0表示障碍\nvector<vector<int>> grid(n + 1, vector<int>(m + 1, 0));\nDSU dsu(q + 1); // 最多会有 q 条鱼被创建\n\nint fish_cnt = 0;\nint last_ans = 0;\n\nint dx[] = {-1, 1, 0, 0};\nint dy[] = {0, 0, -1, 1};\n\nfor (int i = 0; i < q; i++) {\n    int op;\n    cin >> op;\n    if (op == 1) {\n    int x_prime, y_prime, v;\n    cin >> x_prime >> y_prime >> v;\n    int x = x_prime ^ last_ans;\n    int y = y_prime ^ last_ans;\n\n    fish_cnt++;\n    grid[x][y] = fish_cnt;\n    dsu.val[fish_cnt] = v;\n\n    vector<int> neighbors;\n    for (int d = 0; d < 4; d++) {\n    int nx = x + dx[d], ny = y + dy[d];\n    if (nx >= 1 && nx <= n && ny >= 1 && ny <= m && grid[nx][ny] > 0) {\n    neighbors.push_back(dsu.find(grid[nx][ny]));\n    }\n    }\n    // 去重，防止同一个连通块被多次合并导致 sz 重复计算\n    sort(neighbors.begin(), neighbors.end());\n    neighbors.erase(unique(neighbors.begin(), neighbors.end()), neighbors.end());"
        }
    ],
    [
        {
            "type": "code",
